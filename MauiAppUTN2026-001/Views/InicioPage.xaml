<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiAppUTN2026_001.ViewModels"
             x:Class="MauiAppUTN2026_001.Views.InicioPage"
             x:DataType="vm:InicioViewModel"
             Title="{Binding Title}"
             BackgroundColor="#F1F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Header -->
            <VerticalStackLayout Margin="0,8,0,0">
                <Label Text="Hotel Reservas"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="#1E293B" />
                <Label Text="Panel de control"
                       FontSize="15"
                       TextColor="#64748B"
                       Margin="0,2,0,0" />
            </VerticalStackLayout>

            <!-- Total card -->
            <Frame BackgroundColor="#6366F1"
                   Padding="24"
                   CornerRadius="20"
                   BorderColor="Transparent"
                   HasShadow="True">
                <VerticalStackLayout>
                    <Label Text="Total de Reservas"
                           FontSize="14"
                           TextColor="#C7D2FE" />
                    <Label Text="{Binding TotalReservas}"
                           FontSize="48"
                           FontAttributes="Bold"
                           TextColor="White"
                           Margin="0,4,0,0" />
                    <Button Text="Ver todas las reservas"
                            FontSize="13"
                            BackgroundColor="#4F46E5"
                            TextColor="White"
                            CornerRadius="10"
                            Padding="16,8"
                            Margin="0,8,0,0"
                            HorizontalOptions="Start"
                            Command="{Binding GoToReservasCommand}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Stats grid -->
            <Label Text="Resumen por Estado"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#1E293B"
                   Margin="0,4,0,0" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                <!-- Pendientes -->
                <Frame Grid.Row="0" Grid.Column="0"
                       BackgroundColor="White"
                       Padding="16"
                       CornerRadius="16"
                       BorderColor="Transparent"
                       HasShadow="True">
                    <VerticalStackLayout>
                        <Frame BackgroundColor="#FEF3C7"
                               Padding="8,4"
                               CornerRadius="8"
                               BorderColor="Transparent"
                               HasShadow="False"
                               HorizontalOptions="Start">
                            <Label Text="Pendientes"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#F59E0B" />
                        </Frame>
                        <Label Text="{Binding Pendientes}"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="#1E293B"
                               Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Confirmadas -->
                <Frame Grid.Row="0" Grid.Column="1"
                       BackgroundColor="White"
                       Padding="16"
                       CornerRadius="16"
                       BorderColor="Transparent"
                       HasShadow="True">
                    <VerticalStackLayout>
                        <Frame BackgroundColor="#DBEAFE"
                               Padding="8,4"
                               CornerRadius="8"
                               BorderColor="Transparent"
                               HasShadow="False"
                               HorizontalOptions="Start">
                            <Label Text="Confirmadas"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#3B82F6" />
                        </Frame>
                        <Label Text="{Binding Confirmadas}"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="#1E293B"
                               Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Frame>

                <!-- En Curso -->
                <Frame Grid.Row="1" Grid.Column="0"
                       BackgroundColor="White"
                       Padding="16"
                       CornerRadius="16"
                       BorderColor="Transparent"
                       HasShadow="True">
                    <VerticalStackLayout>
                        <Frame BackgroundColor="#EDE9FE"
                               Padding="8,4"
                               CornerRadius="8"
                               BorderColor="Transparent"
                               HasShadow="False"
                               HorizontalOptions="Start">
                            <Label Text="En Curso"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#8B5CF6" />
                        </Frame>
                        <Label Text="{Binding EnCurso}"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="#1E293B"
                               Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Completadas -->
                <Frame Grid.Row="1" Grid.Column="1"
                       BackgroundColor="White"
                       Padding="16"
                       CornerRadius="16"
                       BorderColor="Transparent"
                       HasShadow="True">
                    <VerticalStackLayout>
                        <Frame BackgroundColor="#D1FAE5"
                               Padding="8,4"
                               CornerRadius="8"
                               BorderColor="Transparent"
                               HasShadow="False"
                               HorizontalOptions="Start">
                            <Label Text="Completadas"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#10B981" />
                        </Frame>
                        <Label Text="{Binding Completadas}"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="#1E293B"
                               Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Canceladas -->
                <Frame Grid.Row="2" Grid.Column="0"
                       BackgroundColor="White"
                       Padding="16"
                       CornerRadius="16"
                       BorderColor="Transparent"
                       HasShadow="True">
                    <VerticalStackLayout>
                        <Frame BackgroundColor="#FEE2E2"
                               Padding="8,4"
                               CornerRadius="8"
                               BorderColor="Transparent"
                               HasShadow="False"
                               HorizontalOptions="Start">
                            <Label Text="Canceladas"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#EF4444" />
                        </Frame>
                        <Label Text="{Binding Canceladas}"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="#1E293B"
                               Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Accion rapida -->
                <Frame Grid.Row="2" Grid.Column="1"
                       BackgroundColor="#6366F1"
                       Padding="16"
                       CornerRadius="16"
                       BorderColor="Transparent"
                       HasShadow="True">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToNuevaReservaCommand}" />
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="+"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Nueva Reserva"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#C7D2FE"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Frame>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
