<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiAppUTN2026_001.ViewModels"
             xmlns:models="clr-namespace:MauiAppUTN2026_001.Models"
             xmlns:converters="clr-namespace:MauiAppUTN2026_001.Converters"
             x:Class="MauiAppUTN2026_001.Views.ReservaDetallePage"
             x:DataType="vm:ReservaDetalleViewModel"
             Title="{Binding Title}"
             BackgroundColor="#F1F5F9">

    <ContentPage.Resources>
        <converters:StatusColorConverter x:Key="StatusColorConverter" />
        <converters:StatusTextConverter x:Key="StatusTextConverter" />
        <converters:StatusBackgroundConverter x:Key="StatusBackgroundConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header: Info de la reserva -->
        <Frame Grid.Row="0"
               BackgroundColor="White"
               Margin="16,12,16,4"
               Padding="20"
               CornerRadius="16"
               BorderColor="Transparent"
               HasShadow="True">

            <VerticalStackLayout Spacing="8">
                <!-- Codigo y botones -->
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Label Text="{Binding Reserva.CodigoReserva}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#6366F1" />
                    <Button Grid.Column="1"
                            Text="Editar"
                            FontSize="12"
                            BackgroundColor="#EEF2FF"
                            TextColor="#6366F1"
                            CornerRadius="10"
                            Padding="12,4"
                            HeightRequest="36"
                            Command="{Binding EditReservaCommand}" />
                    <Button Grid.Column="2"
                            Text="Estado"
                            FontSize="12"
                            BackgroundColor="#F0FDF4"
                            TextColor="#10B981"
                            CornerRadius="10"
                            Padding="12,4"
                            HeightRequest="36"
                            Margin="6,0,0,0"
                            Command="{Binding ChangeEstadoCommand}" />
                </Grid>

                <!-- Nombre -->
                <Label Text="{Binding Reserva.NombreHuesped}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#1E293B" />

                <!-- Telefono -->
                <Label Text="{Binding Reserva.Telefono}"
                       FontSize="14"
                       TextColor="#64748B" />

                <!-- Fechas -->
                <Grid ColumnDefinitions="*,Auto,*" Margin="0,4,0,0">
                    <VerticalStackLayout>
                        <Label Text="CHECK-IN" FontSize="10" TextColor="#94A3B8"
                               FontAttributes="Bold" CharacterSpacing="1" />
                        <Label Text="{Binding Reserva.FechaCheckIn, StringFormat='{0:dd MMM yyyy}'}"
                               FontSize="14" TextColor="#1E293B" FontAttributes="Bold" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="--"
                           FontSize="18" TextColor="#CBD5E1"
                           VerticalOptions="Center" Margin="12,0" />
                    <VerticalStackLayout Grid.Column="2">
                        <Label Text="CHECK-OUT" FontSize="10" TextColor="#94A3B8"
                               FontAttributes="Bold" CharacterSpacing="1" />
                        <Label Text="{Binding Reserva.FechaCheckOut, StringFormat='{0:dd MMM yyyy}'}"
                               FontSize="14" TextColor="#1E293B" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Estado -->
                <HorizontalStackLayout Spacing="10" Margin="0,4,0,0">
                    <Frame Padding="10,5"
                           CornerRadius="8"
                           BorderColor="Transparent"
                           HasShadow="False"
                           BackgroundColor="{Binding Reserva.Estado, Converter={StaticResource StatusBackgroundConverter}}">
                        <Label Text="{Binding Reserva.Estado, Converter={StaticResource StatusTextConverter}}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{Binding Reserva.Estado, Converter={StaticResource StatusColorConverter}}" />
                    </Frame>
                    <Label Text="{Binding Reserva.DiasEstancia, StringFormat='{0} noches'}"
                           FontSize="13" TextColor="#64748B" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Frame>

        <!-- Seccion de habitaciones -->
        <VerticalStackLayout Grid.Row="1">
            <Label Text="Habitaciones Reservadas"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#475569"
                   Margin="20,12,20,4" />

            <CollectionView ItemsSource="{Binding Detalles}"
                            SelectionMode="None"
                            Margin="12,4,12,0">

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Padding="40,20">
                        <Label Text="Sin habitaciones"
                               FontSize="16"
                               TextColor="#94A3B8"
                               HorizontalTextAlignment="Center"
                               Margin="0,8,0,4" />
                        <Label Text="Agrega habitaciones a esta reserva"
                               FontSize="13"
                               TextColor="#CBD5E1"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DetalleReserva">
                        <SwipeView Margin="4,4">
                            <SwipeView.LeftItems>
                                <SwipeItems>
                                    <SwipeItem Text="Editar"
                                               BackgroundColor="#3B82F6"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ReservaDetalleViewModel}}, Path=EditDetalleCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.LeftItems>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Eliminar"
                                               BackgroundColor="#EF4444"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ReservaDetalleViewModel}}, Path=DeleteDetalleCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Frame BackgroundColor="White"
                                   Padding="16,12"
                                   CornerRadius="12"
                                   BorderColor="Transparent"
                                   HasShadow="True">

                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Icono -->
                                    <Frame BackgroundColor="#EEF2FF"
                                           WidthRequest="44"
                                           HeightRequest="44"
                                           CornerRadius="12"
                                           BorderColor="Transparent"
                                           HasShadow="False"
                                           Padding="0"
                                           VerticalOptions="Center">
                                        <Label Text="H"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               TextColor="#6366F1"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Frame>

                                    <!-- Info -->
                                    <VerticalStackLayout Grid.Column="1"
                                                         Margin="12,0,0,0"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding DisplayHabitacion}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="#1E293B" />
                                        <Label Text="{Binding DisplayPrecio}"
                                               FontSize="12"
                                               TextColor="#64748B" />
                                    </VerticalStackLayout>

                                    <!-- Subtotal -->
                                    <Label Grid.Column="2"
                                           Text="{Binding Subtotal, StringFormat='${0:N2}'}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#6366F1"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <!-- Footer: Total -->
        <Frame Grid.Row="2"
               BackgroundColor="White"
               Padding="20,14"
               CornerRadius="20"
               BorderColor="Transparent"
               HasShadow="True">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="TOTAL RESERVA" FontSize="11" TextColor="#94A3B8"
                           FontAttributes="Bold" CharacterSpacing="1" />
                    <Label Text="{Binding Reserva.Total, StringFormat='${0:N2}'}"
                           FontSize="26" FontAttributes="Bold" TextColor="#1E293B" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="+ Habitacion"
                        FontSize="14"
                        FontAttributes="Bold"
                        BackgroundColor="#6366F1"
                        TextColor="White"
                        CornerRadius="14"
                        Padding="20,12"
                        Command="{Binding AddDetalleCommand}" />
            </Grid>
        </Frame>
    </Grid>
</ContentPage>
