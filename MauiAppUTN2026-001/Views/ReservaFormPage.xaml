<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiAppUTN2026_001.ViewModels"
             xmlns:models="clr-namespace:MauiAppUTN2026_001.Models"
             xmlns:converters="clr-namespace:MauiAppUTN2026_001.Converters"
             x:Class="MauiAppUTN2026_001.Views.ReservaFormPage"
             x:DataType="vm:ReservaFormViewModel"
             Title="{Binding Title}"
             BackgroundColor="#F1F5F9">

    <ContentPage.Resources>
        <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- ═══ DATOS DE LA RESERVA ═══ -->
            <Frame BackgroundColor="White"
                   Padding="24,20"
                   CornerRadius="20"
                   BorderColor="Transparent"
                   HasShadow="True">

                <VerticalStackLayout Spacing="16">

                    <Label Text="Datos de la Reserva"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#1E293B"
                           Margin="0,0,0,4" />

                    <!-- Nombre -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Nombre del Huesped *"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#475569" />
                        <Frame Padding="12,0"
                               CornerRadius="10"
                               BorderColor="#E2E8F0"
                               HasShadow="False"
                               BackgroundColor="#F8FAFC">
                            <Entry Text="{Binding NombreHuesped}"
                                   Placeholder="Ej: Juan Perez"
                                   PlaceholderColor="#94A3B8"
                                   FontSize="15"
                                   TextColor="#1E293B"
                                   BackgroundColor="Transparent" />
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Telefono -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Telefono"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#475569" />
                        <Frame Padding="12,0"
                               CornerRadius="10"
                               BorderColor="#E2E8F0"
                               HasShadow="False"
                               BackgroundColor="#F8FAFC">
                            <Entry Text="{Binding Telefono}"
                                   Placeholder="Ej: 0999999999"
                                   Keyboard="Telephone"
                                   PlaceholderColor="#94A3B8"
                                   FontSize="15"
                                   TextColor="#1E293B"
                                   BackgroundColor="Transparent" />
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Fechas -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Check-In"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#475569" />
                            <Frame Padding="8,0"
                                   CornerRadius="10"
                                   BorderColor="#E2E8F0"
                                   HasShadow="False"
                                   BackgroundColor="#F8FAFC">
                                <DatePicker Date="{Binding FechaCheckIn}"
                                            FontSize="14"
                                            TextColor="#1E293B"
                                            BackgroundColor="Transparent" />
                            </Frame>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Check-Out"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#475569" />
                            <Frame Padding="8,0"
                                   CornerRadius="10"
                                   BorderColor="#E2E8F0"
                                   HasShadow="False"
                                   BackgroundColor="#F8FAFC">
                                <DatePicker Date="{Binding FechaCheckOut}"
                                            FontSize="14"
                                            TextColor="#1E293B"
                                            BackgroundColor="Transparent" />
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Estado -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Estado"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#475569" />
                        <Frame Padding="8,0"
                               CornerRadius="10"
                               BorderColor="#E2E8F0"
                               HasShadow="False"
                               BackgroundColor="#F8FAFC">
                            <Picker ItemsSource="{Binding Estados}"
                                    SelectedIndex="{Binding SelectedEstadoIndex}"
                                    FontSize="15"
                                    TextColor="#1E293B"
                                    BackgroundColor="Transparent" />
                        </Frame>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <!-- ═══ SELECCIÓN DE HABITACIÓN ═══ -->
            <Frame BackgroundColor="White"
                   Padding="24,20"
                   CornerRadius="20"
                   BorderColor="Transparent"
                   HasShadow="True">

                <VerticalStackLayout Spacing="16">

                    <Label Text="🛏️ Habitación"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#1E293B"
                           Margin="0,0,0,4" />

                    <!-- Picker de habitación -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Seleccionar Habitación *"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#475569" />
                        <Frame Padding="8,0"
                               CornerRadius="10"
                               BorderColor="#E2E8F0"
                               HasShadow="False"
                               BackgroundColor="#F8FAFC">
                            <Picker ItemsSource="{Binding Habitaciones}"
                                    SelectedItem="{Binding SelectedHabitacion}"
                                    ItemDisplayBinding="{Binding Display}"
                                    FontSize="15"
                                    TextColor="#1E293B"
                                    Title="Escoja una habitación"
                                    TitleColor="#94A3B8"
                                    BackgroundColor="Transparent" />
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Info de la habitación seleccionada -->
                    <Frame BackgroundColor="#F8FAFC"
                           Padding="16,12"
                           CornerRadius="12"
                           BorderColor="#E2E8F0"
                           HasShadow="False"
                           IsVisible="{Binding SelectedHabitacion, Converter={StaticResource IsNotNullConverter}}">
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="Número"
                                   FontSize="11"
                                   TextColor="#94A3B8"
                                   FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="{Binding SelectedHabitacion.Numero}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B" />

                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="Tipo"
                                   FontSize="11"
                                   TextColor="#94A3B8"
                                   FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding SelectedHabitacion.Tipo}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#6366F1" />

                            <Label Grid.Row="0" Grid.Column="2"
                                   Text="Precio/Noche"
                                   FontSize="11"
                                   TextColor="#94A3B8"
                                   FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="2"
                                   Text="{Binding SelectedHabitacion.PrecioPorNoche, StringFormat='${0:N2}'}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#10B981" />
                        </Grid>
                    </Frame>

                    <!-- Noches (calculado automáticamente por las fechas) -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Número de Noches"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#475569" />
                        <Frame Padding="12,0"
                               CornerRadius="10"
                               BorderColor="#E2E8F0"
                               HasShadow="False"
                               BackgroundColor="#F0F0F5">
                            <Entry Text="{Binding NumeroNochesText}"
                                   IsReadOnly="True"
                                   FontSize="15"
                                   TextColor="#1E293B"
                                   BackgroundColor="Transparent" />
                        </Frame>
                        <Label Text="Se calcula según las fechas de Check-In y Check-Out"
                               FontSize="11"
                               TextColor="#94A3B8"
                               Margin="4,0,0,0" />
                    </VerticalStackLayout>

                    <!-- Subtotal -->
                    <Frame BackgroundColor="#EEF2FF"
                           Padding="16,12"
                           CornerRadius="12"
                           BorderColor="Transparent"
                           HasShadow="False">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Subtotal:"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#475569"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding Subtotal, StringFormat='${0:N2}'}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="#6366F1"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Frame>

                </VerticalStackLayout>
            </Frame>

            <!-- Botones -->
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="12"
                  Margin="0,8,0,20">

                <Button Text="Cancelar"
                        FontSize="15"
                        FontAttributes="Bold"
                        BackgroundColor="#E2E8F0"
                        TextColor="#64748B"
                        CornerRadius="14"
                        HeightRequest="52"
                        Command="{Binding CancelCommand}" />

                <Button Grid.Column="1"
                        Text="Guardar"
                        FontSize="15"
                        FontAttributes="Bold"
                        BackgroundColor="#6366F1"
                        TextColor="White"
                        CornerRadius="14"
                        HeightRequest="52"
                        Command="{Binding SaveCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
